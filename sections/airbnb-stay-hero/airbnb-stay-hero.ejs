<!-- ========== AIRBNB STAY HERO SECTION ========== -->
<section id="airbnb-stay-hero" class="as-hero">
    <div class="as-hero-bg blur-load">
        <img src="/AirBNB%20Stay/hero-bg.png" alt="Airbnb Stay - Premium and Comfortable Experience" fetchpriority="high"
            decoding="async" onload="this.parentElement.classList.add('loaded')">
    </div>

    <div class="as-hero-content">

        <!-- Main heading -->
        <h1 class="as-hero-title as-hero-animate">
            Premium Stays for a Smooth<br>& Comfortable Experience
        </h1>

        <!-- Subtitle -->
        <p class="as-hero-subtitle as-hero-animate">
            Clean Vibez VIP offers stylish and comfortable short-term stays designed for travelers, business guests, and
            weekend visitors. Enjoy a modern space with premium amenities and a smooth booking experience.
        </p>

        <!-- CTA Button -->
        <a href="/airbnb-stay-book" class="as-hero-cta as-hero-animate">
            <span>Book Your Stay</span>
            <img src="/img/vector5.svg" alt="arrow" width="58" height="58">
        </a>
    </div>
</section>
