<!-- ========== CAR SERVICE SECTION 3: RIDE GALLERY ========== -->
<section id="cs-rides" class="cs-rides-section">
    <div class="cs-rides-inner">

        <!-- Header -->
        <div class="cs-rides-header">
            <h2 class="cs-rides-title">Choose Your Premium and Comfort Ride</h2>
        </div>

        <!-- Cards Grid -->
        <div class="cs-rides-grid">
            <% if (rides && rides.length> 0) { %>
                <% rides.forEach((ride, index)=> { %>
                    <article class="cs-ride-card" 
                        data-title="<%= ride.title %>"
                        data-desc="<%= ride.description %>"
                        data-img="<%= ride.image_url %>"
                        onclick="openCarModal(this)">
                        <img src="<%= ride.image_url %>" alt="<%= ride.title %>" class="cs-ride-card-img" loading="lazy"
                            decoding="async">
                        <div class="cs-ride-card-overlay"></div>
                        <div class="cs-ride-card-content">
                            <h3 class="cs-ride-card-title">
                                <%= ride.title %>
                            </h3>
                            <p class="cs-ride-card-desc">
                                <%= ride.description %>
                            </p>
                        </div>
                        <button type="button" class="cs-ride-card-arrow" onclick="event.stopPropagation(); openCarModal(this.parentElement)">
                            <img src="/Car Service/Grouped Arrow.png" alt="View" class="cs-ride-arrow-img">
                        </button>
                    </article>
                    <% }) %>
                        <% } else { %>
                            <p class="text-white text-center">No ride options available at the moment.</p>
                            <% } %>
        </div>
    </div>

    <!-- CAR MODAL -->
    <div class="hotel-modal-overlay" id="carModal">
        <div class="hotel-modal-content">
            <div class="hm-modal-handle"></div>
            <button class="hotel-modal-close" onclick="closeCarModal()">
                <span class="material-icons">close</span>
            </button>
            <div class="hotel-modal-gallery">
                <img src="" alt="Car 1" class="hm-pic hm-pic-1">
                <img src="" alt="Car 2" class="hm-pic hm-pic-2">
                <img src="" alt="Car 3" class="hm-pic hm-pic-3">
                <img src="" alt="Car 4" class="hm-pic hm-pic-4">
                <img src="" alt="Car 5" class="hm-pic hm-pic-5">
            </div>
            <div class="hotel-modal-body">
                <div class="hm-left-col">
                    <div class="hm-title-row">
                        <div>
                            <h2 class="hm-title" id="hmCarTitle">Car Name</h2>
                            <p class="hm-location">Luxury & Performance</p>
                        </div>
                        <div class="hm-price-box">
                            <div class="hm-price" id="hmCarPrice">$190<span>/Day</span></div>
                            <p class="hm-date">Elite Fleet</p>
                        </div>
                    </div>
                    <div class="hm-features">
                        <div class="hm-feature">
                            <img src="/img/Vector_Model_1.png" alt="Passengers">
                            <span id="hmPassengers">4 Passengers</span>
                        </div>
                        <div class="hm-feature">
                            <img src="/img/Vector_Model_2.png" alt="Transmission">
                            <span id="hmTransmission">Automatic</span>
                        </div>
                        <div class="hm-feature">
                            <img src="/img/Vector_Model_3.png" alt="Fuel">
                            <span id="hmFuel">Petrol</span>
                        </div>
                        <div class="hm-feature">
                            <img src="/img/Vector_Model_4.png" alt="Class">
                            <span id="hmClass">Luxury Class</span>
                        </div>
                    </div>
                    <div class="hm-about">
                        <h3>About Vehicle</h3>
                        <p id="hmCarDesc">Description...</p>
                    </div>
                    <div class="hm-other-amenities">
                        <h3>Vehicle Details</h3>
                        <div id="hmVehicleDetails" class="hm-details-grid">
                            <div class="hm-detail-item"><span class="hm-detail-label">Model</span><span class="hm-detail-value">2024</span></div>
                            <div class="hm-detail-item"><span class="hm-detail-label">Color</span><span class="hm-detail-value">Black Metallic</span></div>
                            <div class="hm-detail-item"><span class="hm-detail-label">Interior</span><span class="hm-detail-value">Premium Leather</span></div>
                            <div class="hm-detail-item"><span class="hm-detail-label">Type</span><span class="hm-detail-value">Executive SUV</span></div>
                            <div class="hm-detail-item"><span class="hm-detail-label">Drive</span><span class="hm-detail-value">AWD</span></div>
                        </div>
                    </div>
                </div>
                <div class="hm-right-col">
                    <h3 class="hm-book-title">Book Your Car</h3>
                    <form id="carModalForm" class="hm-booking-form">
                        <input type="hidden" name="type" value="Car Rental">
                        <input type="hidden" name="carName" id="hmFormCarName" value="">
                        <div class="hm-form-group">
                            <label>Name</label>
                            <input type="text" name="name" id="hmCarFormName" placeholder="Your Name" required>
                        </div>
                        <div class="hm-form-group">
                            <label>Pickup Location</label>
                            <input type="text" name="pickup" placeholder="Where do you need it?">
                        </div>
                        <div class="hm-form-row">
                            <div class="hm-form-group" style="flex: 1;">
                                <label>Start Date</label>
                                <input type="text" name="startDate" placeholder="dd/mm/yyyy">
                            </div>
                            <div class="hm-form-group" style="flex: 1;">
                                <label>End Date</label>
                                <input type="text" name="endDate" placeholder="dd/mm/yyyy">
                            </div>
                        </div>
                        <button type="submit" class="hm-btn" id="hmCarSubmitBtn">Reserve Now</button>
                        <div id="hmCarFeedback" style="margin-top: 10px; text-align: center; color: #fff; font-size: 0.9rem;"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        let slideshowInterval;
        function startMobileSlideshow(modalId) {
            if (window.innerWidth > 768) return;
            const modal = document.getElementById(modalId);
            const images = modal.querySelectorAll('.hotel-modal-gallery .hm-pic');
            if (images.length <= 1) return;
            let currentIndex = 0;
            images.forEach(img => img.classList.remove('active'));
            images[0].classList.add('active');
            clearInterval(slideshowInterval);
            slideshowInterval = setInterval(() => {
                images[currentIndex].classList.remove('active');
                currentIndex = (currentIndex + 1) % images.length;
                images[currentIndex].classList.add('active');
            }, 3000);
        }

        function openCarModal(card) {
            const title = card.dataset.title;
            const desc = card.dataset.desc;
            const img = card.dataset.img;

            document.getElementById('hmCarTitle').innerText = title;
            document.getElementById('hmCarDesc').innerText = desc;
            document.getElementById('hmFormCarName').value = title;
            
            const gallery = document.querySelectorAll('#carModal .hm-pic');
            gallery.forEach(p => p.src = img);

            document.getElementById('carModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            startMobileSlideshow('carModal');
        }

        function closeCarModal() {
            document.getElementById('carModal').classList.remove('active');
            document.body.style.overflow = '';
            clearInterval(slideshowInterval);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('carModalForm');
            if (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    const feedback = document.getElementById('hmCarFeedback');
                    const submitBtn = document.getElementById('hmCarSubmitBtn');
                    submitBtn.disabled = true;
                    feedback.textContent = 'Sending...';
                    
                    try {
                        const formData = new FormData(form);
                        const response = await fetch('/api/book', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                name: formData.get('name'),
                                email: 'N/A',
                                type: formData.get('type') || 'Car Rental',
                                details: Object.fromEntries(formData)
                            })
                        });
                        const result = await response.json();
                        if (result.success) {
                            form.reset();
                            feedback.textContent = 'Request sent successfully!';
                            feedback.style.color = '#4CAF50';
                        } else {
                            feedback.textContent = 'Error: ' + result.error;
                            feedback.style.color = '#ff4d4d';
                        }
                    } catch (err) {
                        feedback.textContent = 'An error occurred.';
                        feedback.style.color = '#ff4d4d';
                    } finally {
                        submitBtn.disabled = false;
                    }
                });
            }
        });
    </script>
</section>