<!-- ========== TESTIMONIALS SECTION ========== -->
<section id="testimonials" class="section testimonials-fullwidth">
  <header class="section-header text-center">
    <h2>Our Client Words</h2>
    <p class="section-lead">
      Every experience we create leaves a story behind — here's what our clients
      have to say about theirs.
    </p>
  </header>

  <div class="testimonials-slider-outer">
    <div class="testimonials-slider-inner" id="testimonials-slider-inner">
      <% if (testimonials && testimonials.length> 0) { %>
        <% testimonials.forEach((test, index)=> { %>
          <article class="testimonial-card">
            <img src="/img/stars<%= test.stars || 5 %>.svg" alt="<%= test.stars || 5 %> stars"
              class="testimonial-stars">
            <blockquote>
              <p>
                <%= test.content %>
              </p>
            </blockquote>
            <footer class="testimonial-author">
              <strong>
                <%= test.author_name %>
              </strong>
              <span>
                <%= test.author_title %>
              </span>
            </footer>
          </article>
          <% }) %>
            <% } else { %>
              <p class="text-white text-center" style="grid-column: 1/-1;">No testimonials found.</p>
              <% } %>
    </div>
  </div>


</section>