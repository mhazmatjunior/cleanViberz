<!-- ========== DESTINATIONS SECTION ========== -->
<section id="destinations" class="section no-top-gap">
  <div class="container">
    <div class="destinations-header-row">
      <div class="destinations-header-left">
        <span class="eyebrow">Destinations</span>
        <div class="destinations-tabs">
          <button class="chip chip-active" data-tab="hotels"><img src="/img/union0.svg" alt="Hotels"
              class="tab-icon"><span>Elite Hotels</span></button>
          <button class="chip" data-tab="cars"><img src="/img/vector2.svg" alt="Cars" class="tab-icon"><span>Luxury
              Cars</span></button>
          <button class="chip" data-tab="chefs"><img src="/img/vector1.svg" alt="Chefs"
              class="tab-icon"><span>Professional Chefs</span></button>
          <button class="chip" data-tab="concierge"><img src="/img/group-15978824000.svg" alt="Concierge"
              class="tab-icon"><span>Concierge</span></button>
        </div>
      </div>
      <div class="destinations-header-right desktop-only">
        <a href="/explore-hotels" id="explore-btn-desktop" class="btn btn-outline destinations-explore-btn">
          Explore More
          <span class="btn-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </span>
        </a>
      </div>
    </div>

    <div class="destinations-grid">
      <% if (destinations && destinations.length> 0) { %>
        <% destinations.forEach((dest, index)=> { %>
          <article class="destination-card destination-fadein-animate" 
            data-category="<%= dest.category %>"
            data-id="<%= dest.id %>"
            data-bedrooms="<%= dest.bedrooms %>"
            data-bathrooms="<%= dest.bathrooms %>"
            data-kitchens="<%= dest.kitchens %>"
            data-sqft="<%= dest.sq_ft %>"
            data-about="<%= dest.about_room %>"
            data-amenities='<%= dest.other_amenities %>'
            onclick="handleCardClick(this)"
            style="display: <%= dest.category === 'hotels' ? 'block' : 'none' %>">
            <div class="destination-image">
              <img src="<%= dest.image_url %>" alt="<%= dest.title %>" loading="lazy" class="dest-img-obj">
            </div>
            <div class="destination-content">
              <h3 class="card-title">
                <%= dest.title %>
              </h3>
              <p class="price card-price"><span class="from">From</span> <strong>
                  <%= dest.price_info %>
                </strong></p>
              <p class="desc text-white card-desc">
                <%= dest.description %>
              </p>
            </div>
          </article>
          <% }) %>
            <% } else { %>
              <p class="text-white text-center" style="grid-column: 1/-1;">No destinations found.</p>
              <% } %>
    </div>

    <div class="destinations-footer mobile-only" style="margin: 30px auto 0 auto;">
      <a href="/explore-hotels" id="explore-btn-mobile" class="btn btn-outline">
        Explore More
        <span class="btn-circle">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </span>
      </a>
    </div>

    <!-- HOTEL MODAL -->
    <div class="hotel-modal-overlay" id="hotelModal">
      <div class="hotel-modal-content">
        <div class="hm-modal-handle"></div>
        <button class="hotel-modal-close" onclick="closeHotelModal()">
          <span class="material-icons">close</span>
        </button>
        <div class="hotel-modal-gallery">
          <img src="" alt="Hotel 1" class="hm-pic hm-pic-1">
          <img src="" alt="Hotel 2" class="hm-pic hm-pic-2">
          <img src="" alt="Hotel 3" class="hm-pic hm-pic-3">
          <img src="" alt="Hotel 4" class="hm-pic hm-pic-4">
          <img src="" alt="Hotel 5" class="hm-pic hm-pic-5">
        </div>
        <div class="hotel-modal-body">
          <div class="hm-left-col">
            <div class="hm-title-row">
              <div>
                <h2 class="hm-title" id="hmTitle">Hotel Name</h2>
                <p class="hm-location">Premium Stay & Comfort</p>
              </div>
              <div class="hm-price-box">
                <div class="hm-price" id="hmPrice">$190<span>/Night</span></div>
                <p class="hm-date">Check current availability</p>
              </div>
            </div>
            <div class="hm-features">
              <div class="hm-feature">
                <img src="/img/Vector_Model_1.png" alt="Bedrooms">
                <span id="hmBedrooms">2 Bedrooms</span>
              </div>
              <div class="hm-feature">
                <img src="/img/Vector_Model_2.png" alt="Bathrooms">
                <span id="hmBathrooms">2 Bathrooms</span>
              </div>
              <div class="hm-feature">
                <img src="/img/Vector_Model_3.png" alt="Kitchens">
                <span id="hmKitchens">1 Kitchens</span>
              </div>
              <div class="hm-feature">
                <img src="/img/Vector_Model_4.png" alt="Sq Ft">
                <span id="hmSqFt">200 Sq Fts</span>
              </div>
            </div>
            <div class="hm-about">
              <h3>About this hotel</h3>
              <p id="hmDesc">Hotel description goes here...</p>
            </div>
            <div class="hm-other-amenities">
              <h3>Other Amenities</h3>
              <div id="hmAmenitiesList" class="hm-amenities-list"></div>
            </div>
          </div>
          <div class="hm-right-col">
            <h3 class="hm-book-title">Reserve Your Stay</h3>
            <form id="hotelModalForm" class="hm-booking-form">
              <input type="hidden" name="type" value="Hotel Stay">
              <input type="hidden" name="hotelName" id="hmFormHotelName" value="">
              <div class="hm-form-group">
                <label>Name</label>
                <input type="text" name="name" id="hmFormName" placeholder="Your Name" required>
              </div>
              <div class="hm-form-row">
                <div class="hm-form-group">
                  <label>Adults</label>
                  <input type="number" name="adults" value="1" min="1">
                </div>
                <div class="hm-form-group">
                  <label>Children</label>
                  <input type="number" name="children" value="0" min="0">
                </div>
              </div>
              <button type="submit" class="hm-btn" id="hmSubmitBtn">Check Availability</button>
              <div id="hmFeedback" style="margin-top: 10px; text-align: center; color: #fff; font-size: 0.9rem;"></div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- CAR MODAL -->
    <div class="hotel-modal-overlay" id="carModal">
      <div class="hotel-modal-content">
        <div class="hm-modal-handle"></div>
        <button class="hotel-modal-close" onclick="closeCarModal()">
          <span class="material-icons">close</span>
        </button>
        <div class="hotel-modal-gallery">
          <img src="" alt="Car 1" class="hm-pic hm-pic-1">
          <img src="" alt="Car 2" class="hm-pic hm-pic-2">
          <img src="" alt="Car 3" class="hm-pic hm-pic-3">
          <img src="" alt="Car 4" class="hm-pic hm-pic-4">
          <img src="" alt="Car 5" class="hm-pic hm-pic-5">
        </div>
        <div class="hotel-modal-body">
          <div class="hm-left-col">
            <div class="hm-title-row">
              <div>
                <h2 class="hm-title" id="hmCarTitle">Car Name</h2>
                <p class="hm-location">Luxury & Performance</p>
              </div>
              <div class="hm-price-box">
                <div class="hm-price" id="hmCarPrice">$190<span>/Day</span></div>
                <p class="hm-date">Elite Fleet</p>
              </div>
            </div>
            <div class="hm-features">
              <div class="hm-feature">
                <img src="/img/Vector_Model_1.png" alt="Passengers">
                <span id="hmPassengers">4 Passengers</span>
              </div>
              <div class="hm-feature">
                <img src="/img/Vector_Model_2.png" alt="Transmission">
                <span id="hmTransmission">Automatic</span>
              </div>
              <div class="hm-feature">
                <img src="/img/Vector_Model_3.png" alt="Fuel">
                <span id="hmFuel">Petrol</span>
              </div>
              <div class="hm-feature">
                <img src="/img/Vector_Model_4.png" alt="Class">
                <span id="hmClass">Luxury Class</span>
              </div>
            </div>
            <div class="hm-about">
              <h3>About Vehicle</h3>
              <p id="hmCarDesc">Description...</p>
            </div>
            <div class="hm-other-amenities">
              <h3>Vehicle Details</h3>
              <div id="hmVehicleDetails" class="hm-details-grid"></div>
            </div>
          </div>
          <div class="hm-right-col">
            <h3 class="hm-book-title">Book Your Car</h3>
            <form id="carModalForm" class="hm-booking-form">
              <input type="hidden" name="type" value="Car Rental">
              <input type="hidden" name="carName" id="hmFormCarName" value="">
              <div class="hm-form-group">
                <label>Name</label>
                <input type="text" name="name" id="hmCarFormName" placeholder="Your Name" required>
              </div>
              <div class="hm-form-group">
                <label>Pickup Location</label>
                <input type="text" name="pickup" placeholder="Where do you need it?">
              </div>
              <div class="hm-form-row">
                <div class="hm-form-group" style="flex: 1;">
                  <label>Start Date</label>
                  <input type="text" name="startDate" placeholder="dd/mm/yyyy">
                </div>
                <div class="hm-form-group" style="flex: 1;">
                  <label>End Date</label>
                  <input type="text" name="endDate" placeholder="dd/mm/yyyy">
                </div>
              </div>
              <button type="submit" class="hm-btn" id="hmCarSubmitBtn">Reserve Now</button>
              <div id="hmCarFeedback" style="margin-top: 10px; text-align: center; color: #fff; font-size: 0.9rem;"></div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- SERVICE MODAL (Chefs/Concierge) -->
    <div class="hotel-modal-overlay" id="serviceModal">
      <div class="hotel-modal-content">
        <div class="hm-modal-handle"></div>
        <button class="hotel-modal-close" onclick="closeServiceModal()">
          <span class="material-icons">close</span>
        </button>
        <div class="hotel-modal-gallery">
          <img src="" alt="Service 1" class="hm-pic hm-pic-1">
          <img src="" alt="Service 2" class="hm-pic hm-pic-2">
          <img src="" alt="Service 3" class="hm-pic hm-pic-3">
          <img src="" alt="Service 4" class="hm-pic hm-pic-4">
          <img src="" alt="Service 5" class="hm-pic hm-pic-5">
        </div>
        <div class="hotel-modal-body">
          <div class="hm-left-col">
            <div class="hm-title-row">
              <div>
                <h2 class="hm-title" id="smTitle">Service Name</h2>
                <p class="hm-location">Professional & Bespoke</p>
              </div>
              <div class="hm-price-box">
                <div class="hm-price" id="smPrice">$400<span>/Event</span></div>
                <p class="hm-date">Elite Service</p>
              </div>
            </div>
            <div class="hm-about">
              <h3>About this Service</h3>
              <p id="smDesc">Description...</p>
            </div>
            <div class="hm-other-amenities">
              <h3>Service Features</h3>
              <div id="smAmenitiesList" class="hm-amenities-list"></div>
            </div>
          </div>
          <div class="hm-right-col">
            <h3 class="hm-book-title">Inquire Now</h3>
            <form id="serviceModalForm" class="hm-booking-form">
              <input type="hidden" name="type" id="smFormType" value="Service Inquiry">
              <input type="hidden" name="serviceName" id="smFormServiceName" value="">
              <div class="hm-form-group">
                <label>Name</label>
                <input type="text" name="name" id="smFormName" placeholder="Your Name" required>
              </div>
              <div class="hm-form-group">
                <label>Date Requested</label>
                <input type="text" name="date" placeholder="dd/mm/yyyy">
              </div>
              <div class="hm-form-group">
                <label>Additional Details</label>
                <input type="text" name="details" placeholder="Any special requests?">
              </div>
              <button type="submit" class="hm-btn" id="smSubmitBtn">Send Inquiry</button>
              <div id="smFeedback" style="margin-top: 10px; text-align: center; color: #fff; font-size: 0.9rem;"></div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <script>
      let slideshowInterval;
      function startMobileSlideshow(modalId) {
        if (window.innerWidth > 768) return;
        const modal = document.getElementById(modalId);
        const images = modal.querySelectorAll('.hotel-modal-gallery .hm-pic');
        if (images.length <= 1) return;
        let currentIndex = 0;
        images.forEach(img => img.classList.remove('active'));
        images[0].classList.add('active');
        clearInterval(slideshowInterval);
        slideshowInterval = setInterval(() => {
          images[currentIndex].classList.remove('active');
          currentIndex = (currentIndex + 1) % images.length;
          images[currentIndex].classList.add('active');
        }, 3000);
      }

      function handleCardClick(card) {
        const cat = card.dataset.category;
        if (cat === 'hotels') {
          openHotelModal(card);
        } else if (cat === 'cars') {
          openCarModal(card);
        } else {
          openServiceModal(card);
        }
      }

      function openHotelModal(card) {
        document.getElementById('hmTitle').innerText = card.querySelector('.card-title').innerText.trim();
        const rawPrice = card.querySelector('.card-price').innerText.trim();
        document.getElementById('hmPrice').innerHTML = rawPrice.toLowerCase().includes('/night') ? rawPrice : rawPrice + '<span>/Night</span>';
        document.getElementById('hmDesc').innerText = card.dataset.about || card.querySelector('.card-desc').innerText.trim();
        document.getElementById('hmFormHotelName').value = document.getElementById('hmTitle').innerText;
        document.getElementById('hmBedrooms').innerText = card.dataset.bedrooms + ' Bedrooms';
        document.getElementById('hmBathrooms').innerText = card.dataset.bathrooms + ' Bathrooms';
        document.getElementById('hmKitchens').innerText = card.dataset.kitchens + ' Kitchens';
        document.getElementById('hmSqFt').innerText = card.dataset.sqft + ' Sq Fts';

        const imgUrl = card.querySelector('.dest-img-obj').src;
        const gallery = document.querySelectorAll('#hotelModal .hm-pic');
        gallery.forEach(img => img.src = imgUrl);

        const amenitiesContainer = document.getElementById('hmAmenitiesList');
        amenitiesContainer.innerHTML = '';
        try {
          const specs = JSON.parse(card.dataset.amenities || '[]');
          if (Array.isArray(specs)) {
            specs.forEach(item => {
              const span = document.createElement('span');
              span.className = 'hm-amenity-chip';
              span.innerText = item;
              amenitiesContainer.appendChild(span);
            });
          }
        } catch(e) {}
        document.getElementById('hotelModal').classList.add('active');
        document.body.style.overflow = 'hidden';
        startMobileSlideshow('hotelModal');
      }

      function closeHotelModal() {
        document.getElementById('hotelModal').classList.remove('active');
        document.body.style.overflow = '';
        clearInterval(slideshowInterval);
      }

      function openCarModal(card) {
        document.getElementById('hmCarTitle').innerText = card.querySelector('.card-title').innerText.trim();
        const rawPrice = card.querySelector('.card-price').innerText.trim();
        document.getElementById('hmCarPrice').innerHTML = rawPrice.toLowerCase().includes('/day') ? rawPrice : rawPrice + '<span>/Day</span>';
        document.getElementById('hmCarDesc').innerText = card.dataset.about || card.querySelector('.card-desc').innerText.trim();
        document.getElementById('hmFormCarName').value = document.getElementById('hmCarTitle').innerText;
        document.getElementById('hmPassengers').innerText = '4 Passengers';
        document.getElementById('hmTransmission').innerText = 'Automatic';
        document.getElementById('hmFuel').innerText = 'Petrol';
        document.getElementById('hmClass').innerText = 'Luxury Class';

        const imgUrl = card.querySelector('.dest-img-obj').src;
        const gallery = document.querySelectorAll('#carModal .hm-pic');
        gallery.forEach(img => img.src = imgUrl);

        const detailsContainer = document.getElementById('hmVehicleDetails');
        detailsContainer.innerHTML = '';
        try {
          const details = JSON.parse(card.dataset.amenities || '{}');
          Object.entries(details).forEach(([label, value]) => {
            const item = document.createElement('div');
            item.className = 'hm-detail-item';
            item.innerHTML = `<span class="hm-detail-label">${label}</span><span class="hm-detail-value">${value}</span>`;
            detailsContainer.appendChild(item);
          });
        } catch(e) {}
        document.getElementById('carModal').classList.add('active');
        document.body.style.overflow = 'hidden';
        startMobileSlideshow('carModal');
      }

      function closeCarModal() {
        document.getElementById('carModal').classList.remove('active');
        document.body.style.overflow = '';
        clearInterval(slideshowInterval);
      }

      function openServiceModal(card) {
        document.getElementById('smTitle').innerText = card.querySelector('.card-title').innerText.trim();
        document.getElementById('smPrice').innerHTML = card.querySelector('.card-price').innerText.trim();
        document.getElementById('smDesc').innerText = card.dataset.about || card.querySelector('.card-desc').innerText.trim();
        document.getElementById('smFormServiceName').value = document.getElementById('smTitle').innerText;
        document.getElementById('smFormType').value = card.dataset.category === 'chefs' ? 'Chef Inquiry' : 'Concierge Inquiry';

        const imgUrl = card.querySelector('.dest-img-obj').src;
        const gallery = document.querySelectorAll('#serviceModal .hm-pic');
        gallery.forEach(img => img.src = imgUrl);

        const amenitiesContainer = document.getElementById('smAmenitiesList');
        amenitiesContainer.innerHTML = '';
        const features = card.dataset.category === 'chefs' ? ['Custom Menu', 'Professional Service', 'Fresh Ingredients'] : ['Personalized Management', '24/7 Support', 'Event Coordination'];
        features.forEach(feat => {
          const span = document.createElement('span');
          span.className = 'hm-amenity-chip';
          span.innerText = feat;
          amenitiesContainer.appendChild(span);
        });

        document.getElementById('serviceModal').classList.add('active');
        document.body.style.overflow = 'hidden';
        startMobileSlideshow('serviceModal');
      }

      function closeServiceModal() {
        document.getElementById('serviceModal').classList.remove('active');
        document.body.style.overflow = '';
        clearInterval(slideshowInterval);
      }

      document.addEventListener('DOMContentLoaded', function () {
        var grid = document.querySelector('.destinations-grid');
        var cards = grid.querySelectorAll('.destination-fadein-animate');
        function fadeInCards() {
          cards.forEach(function (card, i) {
            setTimeout(function () {
              card.classList.add('animate');
            }, i * 120);
          });
        }
        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(function (entries, observer) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                fadeInCards();
                observer.disconnect();
              }
            });
          }, { threshold: 0.15 });
          observer.observe(grid);
        } else {
          fadeInCards();
        }

        var tabs = document.querySelectorAll('.destinations-tabs .chip');
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            tabs.forEach(function (t) { t.classList.remove('chip-active'); });
            tab.classList.add('chip-active');
            var cat = tab.getAttribute('data-tab');
            cards.forEach(function (card) {
              card.style.display = card.getAttribute('data-category') === cat ? '' : 'none';
            });
            var exploreBtns = [document.getElementById('explore-btn-desktop'), document.getElementById('explore-btn-mobile')];
            exploreBtns.forEach(function(btn) {
              if (btn) {
                btn.style.display = '';
                if (cat === 'hotels') btn.href = '/explore-hotels';
                else if (cat === 'cars') btn.href = '/explore-cars';
                else btn.href = '#';
              }
            });
            setTimeout(function () {
              cards.forEach(function (card, i) {
                if (card.style.display !== 'none') {
                  card.classList.remove('animate');
                  setTimeout(function () { card.classList.add('animate'); }, i * 120);
                }
              });
            }, 50);
          });
        });

        // Form Submission logic
        function setupForm(formId, feedbackId, submitBtnId) {
          const form = document.getElementById(formId);
          if (form) {
            form.addEventListener('submit', async function (e) {
              e.preventDefault();
              const feedback = document.getElementById(feedbackId);
              const submitBtn = document.getElementById(submitBtnId);
              submitBtn.disabled = true;
              feedback.textContent = 'Sending...';
              try {
                const formData = new FormData(form);
                const result = await fetch('/api/book', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    name: formData.get('name'),
                    email: 'N/A',
                    type: formData.get('type') || 'General Inquiry',
                    details: Object.fromEntries(formData)
                  })
                }).then(r => r.json());
                if (result.success) {
                  form.reset();
                  feedback.textContent = 'Request sent successfully!';
                  feedback.style.color = '#4CAF50';
                } else {
                  feedback.textContent = 'Error: ' + result.error;
                  feedback.style.color = '#ff4d4d';
                }
              } catch (err) {
                feedback.textContent = 'An error occurred.';
                feedback.style.color = '#ff4d4d';
              } finally {
                submitBtn.disabled = false;
              }
            });
          }
        }
        setupForm('hotelModalForm', 'hmFeedback', 'hmSubmitBtn');
        setupForm('carModalForm', 'hmCarFeedback', 'hmCarSubmitBtn');
        setupForm('serviceModalForm', 'smFeedback', 'smSubmitBtn');
      });
    </script>
  </div>
</section>