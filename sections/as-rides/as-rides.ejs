                    </p>
                </div>
                <button type="button" class="as-ride-card-arrow" onclick="event.stopPropagation(); openHotelModal(this.parentElement)">
                    <img src="/Car Service/Grouped Arrow.png" alt="View" class="as-ride-arrow-img">
                </button>
            </article>

            <!-- Card 3: Family Friendly Suite -->
            <article class="as-ride-card" 
                data-title="Family Friendly Suite"
                data-desc="Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque. Sed ut perspiciatis unde omnis iste natus error sit voluptatem"
                data-img="/AirBNB Stay/Section_3_Pic_3.png"
                data-bedrooms="3" data-bathrooms="2" data-kitchens="1" data-sqft="1800"
                data-amenities='["Kids Play Area", "High Chair", "Washer/Dryer"]'
                onclick="openHotelModal(this)">
