                data-desc="Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque. Sed ut perspiciatis unde omnis iste natus error sit voluptatem"
                data-img="/AirBNB Stay/Section_3_Pic_2.png"
                data-bedrooms="2" data-bathrooms="2" data-kitchens="1" data-sqft="1200"
