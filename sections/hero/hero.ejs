<!-- ========== HERO SECTION ========== -->
<section id="hero" class="section hero">
  <div class="hero-bg blur-load">
    <img src="/img/joshua-ferrer-2-wl-vu-7-bq-ua-a-unsplash0.png" alt="Luxury dining experience" fetchpriority="high"
      decoding="async" onload="this.parentElement.classList.add('loaded')">
  </div>
  <div class="container hero-content">
    <h1 class="hero-title hero-animate-text">Luxury. Comfort. Experience All in One Vibe</h1>
    <p class="hero-subtitle hero-animate-text">
      Whether it's a private dinner, grand event, or a night to remember.
      Clean Vibez VIP brings class, flavor, and comfort to every experience
    </p>
  </div>

  <!-- ========== BOOKING FORM (OVER HERO) ========== -->
  <div class="container hero-booking hero-booking-animate">
    <div class="booking-tabs">
      <button class="chip chip-active">Host</button>
      <button class="chip">Car/Van</button>
      <button class="chip">Concierge</button>
      <button class="chip">Chef</button>
    </div>
    <div class="booking-widget">
      <form class="booking-form" id="heroBookingForm">
        <input type="hidden" name="type" id="bookingType" value="Host">
        <div class="form-group">
          <label>Name</label>
          <input type="text" name="name" id="heroName" placeholder="Your Name" required>
        </div>
        <div class="form-divider"></div>
        <div class="form-group">
          <label>Location</label>
          <input type="text" name="location" placeholder="Address?">
        </div>
        <div class="form-divider"></div>
        <div class="form-group">
          <label>Check In</label>
          <input type="text" name="checkIn" placeholder="Add Dates">
        </div>
        <div class="form-divider"></div>
        <div class="form-group">
          <label>Check Out</label>
          <input type="text" name="checkOut" placeholder="Add Dates">
        </div>
        <div class="form-divider"></div>
        <div class="form-group form-group-guests">
          <label>Guests</label>
          <input type="text" name="guests" placeholder="2 Adults">
        </div>
        <button type="submit" class="btn-submit-circle" id="heroSubmitBtn">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>
      <div id="heroFeedback" class="form-feedback" style="margin-top: 10px; text-align: center; color: #fff;"></div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('heroBookingForm');
    const chips = document.querySelectorAll('.booking-tabs .chip');
    const typeInput = document.getElementById('bookingType');
    const feedback = document.getElementById('heroFeedback');
    const submitBtn = document.getElementById('heroSubmitBtn');

    // Tab switching logic
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        chips.forEach(c => c.classList.remove('chip-active'));
        chip.classList.add('chip-active');
        typeInput.value = chip.textContent;
      });
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const name = document.getElementById('heroName').value.trim();
      if (!name) {
        feedback.textContent = 'Please enter your name.';
        feedback.style.color = '#ff4d4d';
        return;
      }

      submitBtn.disabled = true;
      feedback.textContent = ''; // Clear feedback

      try {
        const formData = new FormData(form);
        const details = Object.fromEntries(formData);

        const response = await fetch('/api/book', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: name,
            email: 'N/A',
            type: 'Hero - ' + typeInput.value,
            details: details
          })
        });

        const result = await response.json();
        if (result.success) {
          form.reset();
        } else {
          feedback.textContent = 'Error: ' + (result.error || 'Failed to send.');
          feedback.style.color = '#ff4d4d';
        }
      } catch (err) {
        console.error(err);
      } finally {
        submitBtn.disabled = false;
      }
    });
  });
</script>