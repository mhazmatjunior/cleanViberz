<!-- ========== CAR SERVICE SECTION 3: RIDE GALLERY ========== -->
<section id="cs-rides" class="cs-rides-section">
    <div class="cs-rides-inner">

        <!-- Header -->
        <div class="cs-rides-header">
            <h2 class="cs-rides-title">Choose Your Premium and Comfort Ride</h2>
        </div>

        <!-- Cards Grid -->
        <div class="cs-rides-grid">
            <% if (rides && rides.length> 0) { %>
                <% rides.forEach((ride, index)=> { %>
                    <div class="cs-ride-card">
                        <img src="<%= ride.image_url %>" alt="<%= ride.title %>" class="cs-ride-card-img" loading="lazy"
                            decoding="async">
                        <div class="cs-ride-card-overlay"></div>
                        <div class="cs-ride-card-content">
                            <h3 class="cs-ride-card-title">
                                <%= ride.title %>
                            </h3>
                            <p class="cs-ride-card-desc">
                                <%= ride.description %>
                            </p>
                        </div>
                        <div class="cs-ride-card-arrow">
                            <img src="/Car Service/Grouped Arrow.png" alt="View" class="cs-ride-arrow-img">
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <p class="text-white text-center">No ride options available at the moment.</p>
                            <% } %>
        </div>
    </div>
</section>