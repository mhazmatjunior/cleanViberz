</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('services');
    var content = section.querySelector('.services-content-animate');
    var cards = section.querySelectorAll('.service-card-animate');
    function animateServices() {
      content.classList.add('animate');
      cards.forEach(function (card) {
        card.classList.add('animate');
      });
    }
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            animateServices();
            observer.disconnect();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(section);
    } else {
      // fallback
      animateServices();
    }
  });
</script>
<!-- ========== SERVICES SECTION ========== -->
<section id="services" class="section section-dark section-spacing">
  <div class="container">
    <div class="services-layout">
      <div class="services-content services-content-animate">
        <span class="eyebrow">Services</span>
        <h2>Luxury Services, Crafted for Every Occasion</h2>
        <p>
          At Clean Vibez VIP, every service is designed to bring ease, style, and
          sophistication to your life.Whether you're hosting a private dinner,
          planning an event, or traveling in comfort — our team ensures every detail
          reflects perfection.
        </p>
        <p>
          From fine dining to flawless coordination, we turn ordinary moments into
          signature experiences.
        </p>
        <a href="#" class="btn btn-outline">
          Explore More
          <span class="btn-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </span>
        </a>
      </div>

      <div class="services-grid">
        <% if (services && services.length> 0) { %>
          <% services.forEach((svc, index)=> { %>
            <article class="service-card service-card-animate" style="animation-delay:<%= svc.animation_delay %>">
              <div class="service-icon">
                <img src="<%= svc.icon_path %>" alt="" loading="lazy" decoding="async">
              </div>
              <h3>
                <%= svc.title %>
              </h3>
              <p>
                <%= svc.description %>
              </p>
            </article>
            <% }) %>
              <% } else { %>
                <p class="text-white">No services found.</p>
                <% } %>
      </div>
    </div>

    <div class="divider-line-wrapper divider-fadein-animate">
      <img src="/img/divider_line.svg" alt="divider line" class="divider-line-img">
    </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Services section animation (already present)
    var section = document.getElementById('services');
    var content = section.querySelector('.services-content-animate');
    var cards = section.querySelectorAll('.service-card-animate');
    var divider = section.querySelector('.divider-fadein-animate');
    function animateServices() {
      content.classList.add('animate');
      cards.forEach(function (card) {
        card.classList.add('animate');
      });
      if (divider) divider.classList.add('animate');
    }
    function resetServices() {
      content.classList.remove('animate');
      cards.forEach(function (card) {
        card.classList.remove('animate');
      });
      if (divider) divider.classList.remove('animate');
    }
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            animateServices();
          } else {
            resetServices();
          }
        });
      }, { threshold: 0.2 });
      observer.observe(section);
    } else {
      animateServices();
    }
  });
</script>
</div>
</section>